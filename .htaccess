<IfModule mod_headers.c>
    # Кэш статики: CSS, JS, изображения — 7 дней (повторные заходы быстрее)
    <FilesMatch "\.(css|js|png|jpe?g|gif|webp|svg|ico|woff2?)(\?.*)?$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    # PDF: показывать inline в браузере (не скачивать), с правильным MIME
    <FilesMatch "\.pdf$">
        Header set Content-Type "application/pdf"
        Header set Content-Disposition "inline"
        Header set X-Content-Type-Options "nosniff"
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Служебные файлы по HTTP не отдаём: корень сайта на хостинге = корень репозитория.
    # Папки: git, CI, редакторы, код приложения, база данных, документы, скрипты, черновики.
    RewriteRule ^(\.git|\.github|\.vscode|\.idea|\.cursor|\.claude|app|storage|docs|scripts|seo_texts|seo_texts_202_439|vendor|node_modules)(/|$) - [F,NC,L]
    # Отдельные файлы в корне и dev-страницы в public/.
    RewriteRule ^(get_urls\.php|composer\.(json|lock)|Dockerfile|docker-compose\.yml|deploy\.ps1|deploy-sftp-batch\.txt|sftp-config\.json|start-server.*|_commit_msg\.txt|public/(router|test)\.php)$ - [F,NC,L]
    # Базы, дампы, выгрузки и документы по расширению (PDF для скачивания остаются доступными).
    RewriteRule \.(sqlite3?|bak)(\.|_|$) - [F,NC,L]
    RewriteRule \.(db|sql|csv|xlsx|md|log|ps1|bat|zip|docx|json)$ - [F,NC,L]

    # Редирект HTTP → HTTPS (301)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Все запросы без реального файла/папки — в index.php (фронт-контроллер)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
